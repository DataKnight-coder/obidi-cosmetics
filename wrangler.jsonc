{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obidi-cosmetics",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "staging": {
      "name": "obidi-cosmetics-staging",
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "obidi-cosmetics-staging",
          "database_id": "6fdbd79f-6c4e-4c9f-8077-8fcfb24c049e",
          "migrations_dir": "prisma/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PRODUCT_IMAGES",
          "bucket_name": "obidi-cosmetics-images-staging",
          "preview_bucket_name": "obidi-cosmetics-images-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "ANALYTICS_QUEUE",
            "queue": "obidi-analytics-staging"
          },
          {
            "binding": "EMAIL_QUEUE",
            "queue": "obidi-email-staging"
          }
        ],
        "consumers": [
          {
            "queue": "obidi-analytics-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "obidi-analytics-staging-dlq"
          },
          {
            "queue": "obidi-email-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "obidi-email-staging-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PAYMENT_COORDINATOR",
            "class_name": "PaymentCoordinator"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["PaymentCoordinator"]
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "vars": {
        "APP_URL": "https://obidi-cosmetics-staging.berrinagency.workers.dev",
        "AUTH_TRUST_HOST": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
